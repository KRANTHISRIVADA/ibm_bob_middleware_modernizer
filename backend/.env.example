PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
ARTIFACTS_DIR=./artifacts
DB_PATH=./data/modernizer.db

# ─────────────────────────────────────────────────────────────
# LLM PROVIDER — pick ONE and set LLM_PROVIDER to its value
# ─────────────────────────────────────────────────────────────
LLM_PROVIDER=groq

# ── OPTION 1: Groq (FREE — recommended for getting started) ──
# Sign up free (no credit card): https://console.groq.com
# Best models: llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── OPTION 2: Google Gemini (FREE — 1500 requests/day) ───────
# Endpoint: https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
# Auth: x-goog-api-key header  (NOT query param)
# Get key free: https://aistudio.google.com/app/apikey
# LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# ── OPTION 3: Ollama (LOCAL — completely free, no internet) ──
# Install: https://ollama.com/download
# Then pull a model: ollama pull llama3.2
# Ollama starts automatically after install — runs on localhost:11434
# LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── OPTION 4: OpenAI (Paid — best quality) ───────────────────
# https://platform.openai.com/api-keys
# LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ── OPTION 5: IBM watsonx.ai (Lite plan free tier) ───────────
# https://cloud.ibm.com/catalog/services/watson-machine-learning
# LLM_PROVIDER=watsonx
IBM_WATSONX_API_KEY=your_watsonx_key_here
IBM_WATSONX_PROJECT_ID=your_project_id_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSONX_MODEL=ibm/granite-13b-chat-v2
